{
  "name": "redirector",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/rtholmes/redirector",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.2",
    "express-session": "^1.19.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-http": "^5.1.2",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('build', {recursive: true, force: true})\" && tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "mocha --import=tsx 'test/**/*.spec.ts' --exit",
    "cover": "c8 yarn run test"
  },
  "engines": {
    "node": ">=24"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "reporter": [
      "text-summary",
      "html"
    ]
  }
}
