{
  "name": "redirector",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/rtholmes/redirector",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "handlebars": "^4.7.10",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('build', {recursive: true, force: true})\" && tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-reporter=spec 'test/**/*.spec.ts'",
    "cover": "node --import tsx --test --test-reporter=spec --experimental-test-coverage --test-coverage-include='src/**' 'test/**/*.spec.ts'"
  },
  "engines": {
    "node": ">=24"
  }
}
